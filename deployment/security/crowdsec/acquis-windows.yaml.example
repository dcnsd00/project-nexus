# Replace this placeholder with the absolute path to the NEXUS Caddy access logs.
# Example: C:\Users\<user>\source\project-nexus\deployment\security\coraza\logs\access.log*
# Matches access.log and uncompressed rolled files access-<timestamp>-<reason>.log.
# Does not match the separate Coraza audit.log.
filenames:
  - 'C:\PATH\TO\project-nexus\deployment\security\coraza\logs\access.log*'
labels:
  type: caddy
